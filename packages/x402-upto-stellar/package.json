{
  "name": "x402-upto-stellar",
  "version": "0.1.0",
  "description": "The x402 `upto` payment scheme for Stellar: client, server and facilitator, mirroring @x402/stellar",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codekaya/x402-upto-stellar.git",
    "directory": "packages/x402-upto-stellar"
  },
  "keywords": [
    "x402",
    "stellar",
    "soroban",
    "upto",
    "payments",
    "metered"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./upto/client": {
      "types": "./dist/upto/client/index.d.ts",
      "default": "./dist/upto/client/index.js"
    },
    "./upto/server": {
      "types": "./dist/upto/server/index.d.ts",
      "default": "./dist/upto/server/index.js"
    },
    "./upto/facilitator": {
      "types": "./dist/upto/facilitator/index.d.ts",
      "default": "./dist/upto/facilitator/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.3.1",
    "@x402/core": "~2.28.0",
    "@x402/stellar": "~2.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "homepage": "https://github.com/codekaya/x402-upto-stellar/tree/main/packages/x402-upto-stellar",
  "bugs": {
    "url": "https://github.com/codekaya/x402-upto-stellar/issues"
  }
}
